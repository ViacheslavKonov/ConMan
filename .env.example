# Production container images (built by GitHub Actions and published to GHCR)
CONMAN_IMAGE_REGISTRY=ghcr.io/viacheslavkonov
CONMAN_IMAGE_TAG=latest

POSTGRES_DB=conman
POSTGRES_USER=conman
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

APP_ENV=production
APP_NAME=ConMan
SESSION_TTL_HOURS=12

# LAN test:
APP_HOST=:80
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Production example:
# APP_HOST=conman.example.com
# COOKIE_SECURE=true
# COOKIE_DOMAIN=conman.example.com

# For a controlled production rollout, pin all ConMan images to a commit SHA:
# CONMAN_IMAGE_TAG=<full-git-commit-sha>
